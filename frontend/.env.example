# Supabase の管理画面（Project Settings → API）からコピーして、
# このファイルを .env.local という名前で保存してください。
# .env.local はパスワード帳のようなもので、Git には上がりません。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# バックエンド（FastAPI）。省略時は http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
