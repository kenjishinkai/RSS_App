# ローカル PostgreSQL（Terraform で作成した newsdesk）
DATABASE_URL=postgresql+psycopg://newsdesk:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/newsdesk

# 自動テスト用（pytest / E2E）。未設定時は pytest が newsdesk_test を使う
# TEST_DATABASE_URL=postgresql+psycopg://newsdesk:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/newsdesk_test

# AI（Google Gemini。Google AI Studio の API キー。未設定でも RSS 取得と書き込みは動きます）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 省略可。未設定時は gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# 手動ジョブ API をブラウザから叩くとき用（カンマ区切り可）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ログイン用 JWT（十分な長さのランダム文字列）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 省略可（既定: 10080 = 7日）
JWT_EXPIRE_MINUTES=10080
