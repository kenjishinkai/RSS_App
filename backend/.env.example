# Supabase（バックエンド専用）
# Project Settings → API の URL と service_role キーを入れてください。
# service_role はブラウザやフロントの .env には絶対に入れないでください。
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI（Google Gemini。Google AI Studio の API キー。未設定でも RSS 取得と書き込みは動きます）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 省略可。未設定時は gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# 手動ジョブ API をブラウザから叩くとき用（カンマ区切り可）
CORS_ORIGINS=http://localhost:3000
