# Supabase（バックエンド専用）
# Project Settings → API の URL と service_role キーを入れてください。
# service_role は金庫のマスターキーです。ブラウザやフロントの .env には絶対に入れないでください。
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI（要約・重要度付け。未設定でも RSS 取得と書き込みは動きます）
OPENAI_API_KEY=
# 省略可。未設定時は gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# 手動ジョブ API をブラウザから叩くとき用（カンマ区切り可）
CORS_ORIGINS=http://localhost:3000
